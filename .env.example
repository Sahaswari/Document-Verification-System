# ===========================================
# BLOCKCHAIN ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# LOCAL DEVELOPMENT (Hardhat)
# ===========================================
BLOCKCHAIN_NETWORK=local
LOCAL_RPC_URL=http://blockchain:8545
LOCAL_CHAIN_ID=1337

# ===========================================
# DEPLOYED CONTRACT ADDRESS
# ===========================================
# Fill this after deployment (automatic with docker-compose)
LOCAL_CONTRACT_ADDRESS=

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@database:5432/document_verification

# ===========================================
# FLASK
# ===========================================
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# ===========================================
# ACADEMIC PROJECT SETTINGS
# ===========================================
# Enable demo mode for presentation
DEMO_MODE=true
# Show detailed blockchain interactions in logs
DEBUG_BLOCKCHAIN=true
