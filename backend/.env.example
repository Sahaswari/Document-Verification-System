# Blockchain Configuration
# Copy this file to .env and update values as needed

# Blockchain Node URL
# For Docker: http://blockchain:8545
# For local development: http://localhost:8545
BLOCKCHAIN_URL=http://localhost:8545

# Contract Address (will be set after deployment)
# Leave empty - automatically loaded from deployed contract file
CONTRACT_ADDRESS=

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-this

# Upload Configuration
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# IPFS Configuration (optional - for future use)
IPFS_URL=http://localhost:5001
USE_IPFS=False
