# Hardhat Environment Variables

# Private Keys (for production deployment only - NEVER commit real keys!)
# For local development, these are not needed

# Ethereum Network URLs (for production)
# MAINNET_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
# TESTNET_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Etherscan API Key (for contract verification)
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# For local development (default values)
LOCAL_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
